audio_policy_root = "//foundation/multimedia/audio_framework/services/audio_policy"

import("//build/ohos.gni")
import("${audio_policy_root}/../../accessibility.gni")
import("${audio_policy_root}/../../appgallery.gni")
import("${audio_policy_root}/../../audio_framework_test_sources.gni")
import("${audio_policy_root}/../../av_session.gni")
import("${audio_policy_root}/../../bluetooth_part.gni")
import("${audio_policy_root}/../../config.gni")

config("server_proxy_include") {
  include_dirs = [
    "${audio_policy_root}/client/service/include",
    "${audio_policy_root}/common/include",
    "${audio_policy_root}/client/interface",
    "${audio_policy_root}/server/proxy/include",
    "${audio_policy_root}/../audio_service/client/include",
    "${audio_policy_root}/../../frameworks/native/hdiadapter_new/include/common",
  ]
}

ohos_static_library("server_proxy_static_library") {
  sources = [
    "src/audio_anahs_manager_listener_proxy.cpp",
    "src/audio_client_tracker_callback_proxy.cpp",
    "src/audio_concurrency_state_listener_proxy.cpp",
    "src/audio_policy_client_proxy.cpp",
    "src/audio_policy_manager_listener_proxy.cpp",
    "src/audio_routing_manager_listener_proxy.cpp",
    "src/audio_spatialization_state_change_listener_proxy.cpp",
    "src/sle_audio_operation_callback_proxy.cpp",
  ]

  sanitize = {
    cfi = true
    cfi_cross_dso = true
    cfi_vcall_icall_only = true
    debug = false
    integer_overflow = true
    ubsan = true
    boundary_sanitize = true
  }

  public_configs = [ ":server_proxy_include" ]

  cflags = [
    "-Wall",
    "-Werror",
  ]

  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }

  if (accessibility_enable == true) {
    cflags += [ "-DACCESSIBILITY_ENABLE" ]
  }

  if (bluetooth_part_enable == true) {
    cflags += [ "-DBLUETOOTH_ENABLE" ]
  }

  if (avsession_part_enable == true && !(use_libfuzzer || use_clang_coverage)) {
    cflags += [ "-DAVSESSION_ENABLE" ]
  }

  ldflags = [ "-Wl" ]

  defines = []
  if (audio_framework_feature_wired_audio) {
    defines += [ "AUDIO_WIRED_DETECT" ]
  }

  if (build_variant == "user") {
    defines += [ "AUDIO_BUILD_VARIANT_USER" ]
  } else if (build_variant == "root") {
    defines += [ "AUDIO_BUILD_VARIANT_ROOT" ]
  }

  if (use_libfuzzer || use_clang_coverage) {
    defines += [ "TEST_COVERAGE" ]
  }

  if (audio_framework_feature_support_os_account) {
    defines += [ "SUPPORT_USER_ACCOUNT" ]
  }

  if (audio_framework_feature_dtmf_tone) {
    defines += [ "FEATURE_DTMF_TONE" ]
  }

  if (is_emulator) {
    defines += [ "IS_EMULATOR" ]
  }

  if (audio_framework_feature_inner_capturer) {
    defines += [ "HAS_FEATURE_INNERCAPTURER" ]
  }

  deps = [
    "${audio_policy_root}/../../frameworks/native/audioadapter:pulse_audio_service_adapter",
    "${audio_policy_root}/../../frameworks/native/audioutils:audio_utils",
    "${audio_policy_root}/../audio_policy:audio_foundation",
    "${audio_policy_root}/../audio_service:audio_common",
  ]

  external_deps = [
    "hilog:libhilog",
    "ability_runtime:app_manager",
    "hdf_core:libhdi",
    "safwk:system_ability_fwk",
    "samgr:samgr_proxy",
  ]

  public_external_deps = [ "ffrt:libffrt" ]

  public_external_deps += [
    "libxml2:libxml2",
    "openssl:libcrypto_shared",
  ]

  if (audio_framework_feature_usb_audio) {
    defines += [ "USB_ENABLE" ]
    public_external_deps += [ "usb_manager:usbsrv_client" ]
  }

  if (audio_framework_feature_detect_soundbox) {
    defines += [ "DETECT_SOUNDBOX" ]
  }

  if (audio_framework_config_policy_enable) {
    defines += [ "USE_CONFIG_POLICY" ]
    external_deps += [ "config_policy:configpolicy_util" ]
  }

  if (appgallery_part_enable == true) {
    defines += [ "FEATURE_APPGALLERY" ]
  }

  if (bluetooth_part_enable == true) {
    deps += [ "${audio_policy_root}/../../frameworks/native/bluetoothclient:audio_bluetooth_client" ]
    external_deps += [ "bluetooth:btframework" ]
  }

  if (audio_framework_feature_input) {
    defines += [ "FEATURE_MULTIMODALINPUT_INPUT" ]
    external_deps += [ "input:libmmi-client" ]
  }

  if (audio_framework_feature_device_manager) {
    defines += [ "FEATURE_DEVICE_MANAGER" ]
    external_deps += [ "device_manager:devicemanagersdk" ]
  }

  cflags += [ "-Os" ]
  cflags_cc = cflags
  subsystem_name = "multimedia"
  part_name = "audio_framework"
}
